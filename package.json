{
  "name": "associationhog",
  "version": "0.1.0",
  "description": "Scrape internet resources and store posts into a local SQLite database",
  "type": "module",
  "scripts": {
    "parse:halooglasi": "node parse/halooglasi/parseHaloOglasi.js",
    "parse:kupujemprodajem": "node parse/kupujemprodajem/parseKupujemProdajem.js",
    "parse:telegram": "node parse/telegram/parseTelegram.js",
    "enrich:telegram:llm": "node parse/telegram/enrichTelegramWithLlm.js",
    "enrich:halooglasi:web": "node parse/halooglasi/enrichHaloOglasiWithWeb.js",
    "enrich:halooglasi:llm": "node parse/halooglasi/enrichHaloOglasiWithLlm.js",
    "enrich:kupujemprodajem:web": "node parse/kupujemprodajem/enrichKupujemProdajemWithWeb.js",
    "enrich:kupujemprodajem:llm": "node parse/kupujemprodajem/enrichKupujemProdajemWithLlm.js",
    "recheck:halooglasi": "node parse/halooglasi/recheckHaloOglasi.js",
    "recheck:kupujemprodajem": "node parse/kupujemprodajem/recheckKupujemProdajem.js",
    "db:init": "node parse/lib/db.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "puppeteer": "^25.8.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "telegram": "^2.26.22",
    "teleproto": "^1.228.5"
  },
  "allowScripts": {
    "puppeteer@25.8.0": true
  }
}